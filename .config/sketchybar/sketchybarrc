#!/bin/bash

# Load colors first (needed by style)
source "$HOME/.config/sketchybar/colors.sh"

# Load style (uses color variables)
STYLE_FILE="$HOME/.config/sketchybar/style.sh"
if [ -f "$STYLE_FILE" ]; then
    source "$STYLE_FILE"
else
    # Default style values if no style file exists
    export BAR_HEIGHT=42
    export BAR_COLOR=0x00000000
    export BAR_BLUR_RADIUS=0
    export BAR_SHADOW=off
    export BAR_BORDER_WIDTH=0
    export BAR_PADDING_LEFT=10
    export BAR_PADDING_RIGHT=10
    export BAR_POSITION=top
    
    export ITEM_BG_COLOR=$BG1
    export ITEM_BG_HEIGHT=32
    export ITEM_BG_CORNER_RADIUS=0
    export ITEM_BG_BORDER_WIDTH=3
    export ITEM_BG_BORDER_COLOR=$BORDER_COLOR
    export ITEM_PADDING_LEFT=2
    export ITEM_PADDING_RIGHT=2
    export ITEM_MARGIN=4
    
    export ICON_PADDING_LEFT=10
    export ICON_PADDING_RIGHT=4
    export LABEL_PADDING_LEFT=4
    export LABEL_PADDING_RIGHT=10
    
    export WS_BG_HEIGHT=32
    export WS_BG_CORNER_RADIUS=0
    export WS_BG_BORDER_WIDTH=3
    export WS_LABEL_PADDING_LEFT=12
    export WS_LABEL_PADDING_RIGHT=12
    
    export SHOW_MUSIC=true
    export SHOW_DATE_ICON=true
    export SHOW_CLOCK_ICON=true
fi

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"
FONT="VictorMono Nerd Font Mono:Regular:16.0"

# --- Bar Settings ---
sketchybar --bar height=$BAR_HEIGHT \
                 color=$BAR_COLOR \
                 position=$BAR_POSITION \
                 padding_left=$BAR_PADDING_LEFT \
                 padding_right=$BAR_PADDING_RIGHT \
                 blur_radius=$BAR_BLUR_RADIUS \
                 shadow=$BAR_SHADOW \
                 border_width=$BAR_BORDER_WIDTH \
                 display=all

# --- Default Item Settings ---
sketchybar --default icon.font="$FONT" \
                     label.font="$FONT" \
                     icon.color=$FG0 \
                     label.color=$FG0 \
                     background.color=$ITEM_BG_COLOR \
                     background.corner_radius=$ITEM_BG_CORNER_RADIUS \
                     background.border_width=$ITEM_BG_BORDER_WIDTH \
                     background.border_color=$BORDER_COLOR \
                     background.height=$ITEM_BG_HEIGHT \
                     background.padding_left=$ITEM_PADDING_LEFT \
                     background.padding_right=$ITEM_PADDING_RIGHT \
                     icon.padding_left=$ICON_PADDING_LEFT \
                     icon.padding_right=$ICON_PADDING_RIGHT \
                     label.padding_left=$LABEL_PADDING_LEFT \
                     label.padding_right=$LABEL_PADDING_RIGHT \
                     margin=$ITEM_MARGIN

# --- Left: Apple Logo Power Menu ---
source "$PLUGIN_DIR/apple.sh"

# --- Left: Yabai Workspaces ---
for sid in {1..10}; do
  DRAWING="off"
  if [[ "${SHOW_EMPTY_WORKSPACES:-true}" = "true" ]] && [[ "$sid" =~ ^[1-5]$ ]]; then DRAWING="on"; fi

  sketchybar --add space space.$sid left \
             --set space.$sid \
                   associated_space=$sid \
                   drawing=$DRAWING \
                   icon.drawing=off \
                   label="$sid" \
                   label.font="$FONT" \
                   label.padding_left=${WS_LABEL_PADDING_LEFT:-12} \
                   label.padding_right=${WS_LABEL_PADDING_RIGHT:-12} \
                   label.y_offset=1 \
                   background.color=${WS_BG_COLOR:-$BG1} \
                   background.height=${WS_BG_HEIGHT:-32} \
                   background.corner_radius=${WS_BG_CORNER_RADIUS:-0} \
                   background.border_width=${WS_BG_BORDER_WIDTH:-3} \
                   background.border_color=$BORDER_COLOR \
                   click_script="yabai -m space --focus $sid" \
                   script="$PLUGIN_DIR/space.sh $sid"
done

# --- Date and Time ---
if [ "${DATE_TIME_AROUND_NOTCH:-false}" = "true" ]; then
    # Nordic style: Date left of notch, Time right of notch
    sketchybar --add item date q \
               --set date update_freq=60 \
                          icon.drawing=off \
                          label.font="$FONT" \
                          label.color=$FG0 \
                          script="$PLUGIN_DIR/date.sh"

    sketchybar --add item clock e \
               --set clock update_freq=10 \
                           icon.drawing=off \
                           label.font="$FONT" \
                           label.color=$FG0 \
                           script="$PLUGIN_DIR/clock.sh" \
                           click_script="$PLUGIN_DIR/toggle_stats.sh"
else
    # Default style: Both on right side with icons
    if [ "$SHOW_CLOCK_ICON" = "true" ]; then
        CLOCK_ICON="󱑎"
    else
        CLOCK_ICON=""
    fi
    sketchybar --add item clock right \
               --set clock update_freq=10 \
                           icon="$CLOCK_ICON" \
                           icon.font="SF Pro:Bold:16.0" \
                           icon.color=$BLUE \
                           script="$PLUGIN_DIR/clock.sh" \
                           click_script="$PLUGIN_DIR/toggle_stats.sh"

    if [ "$SHOW_DATE_ICON" = "true" ]; then
        DATE_ICON="󰃭"
    else
        DATE_ICON=""
    fi
    sketchybar --add item date right \
               --set date update_freq=1000 \
                          icon="$DATE_ICON" \
                          icon.font="SF Pro:Bold:16.0" \
                          icon.color=$BLUE \
                          script="$PLUGIN_DIR/date.sh"
fi

# --- Right: Battery ---
sketchybar --add item battery right \
           --set battery update_freq=5 \
                         icon.font="VictorMono Nerd Font Mono:Bold:18.0" \
                         icon.y_offset=0 \
                         icon.padding_left=10 \
                         icon.padding_right=4 \
                         label.padding_left=0 \
                         label.padding_right=10 \
                         background.padding_left=16 \
                         script="$PLUGIN_DIR/battery.sh"

# --- Right: Wi-Fi ---
sketchybar --add item wifi right \
           --set wifi update_freq=5 \
                      icon="􀙇" \
                      icon.font="SF Pro:Bold:16.0" \
                      icon.color=$YELLOW \
                      icon.padding_left=10 \
                      icon.padding_right=10 \
                      script="$PLUGIN_DIR/wifi.sh" \
                      click_script="open x-apple.systempreferences:com.apple.wifi-settings-extension"

# --- Right: Bluetooth ---
sketchybar --add item bluetooth right \
           --set bluetooth icon="󰂯" \
                           icon.font="VictorMono Nerd Font Mono:Bold:18.0" \
                           icon.color=$ORANGE \
                           icon.padding_left=10 \
                           icon.padding_right=10 \
                           label.drawing=off \
                           update_freq=2 \
                           script="$PLUGIN_DIR/bluetooth.sh" \
                           click_script="open x-apple.systempreferences:com.apple.BluetoothSettings"

# --- Right: Homebrew ---
sketchybar --add item brew right \
           --set brew icon="󰏗" \
                      icon.font="VictorMono Nerd Font Mono:Bold:24.0" \
                      icon.color=$GREEN \
                      icon.padding_right=6 \
                      label.padding_left=2 \
                      update_freq=3600 \
                      script="$PLUGIN_DIR/brew.sh"

# --- Right: Network Speed ---
sketchybar --add item network.down right \
           --set network.down label.font="VictorMono Nerd Font Mono:Bold:10.0" \
                              label.y_offset=6 \
                              width=0 \
                              icon="↓" \
                              icon.font="VictorMono Nerd Font Mono:Bold:10.0" \
                              icon.color=$ORANGE \
                              icon.y_offset=6 \
                              icon.padding_right=2 \
           --add item network.up right \
           --set network.up label.font="VictorMono Nerd Font Mono:Bold:10.0" \
                            label.y_offset=-4 \
                            icon="↑" \
                            icon.font="VictorMono Nerd Font Mono:Bold:10.0" \
                            icon.color=$ORANGE \
                            icon.y_offset=-4 \
                            icon.padding_right=2 \
                            update_freq=2 \
                            script="$PLUGIN_DIR/network.sh"

# --- Right: CPU Graph & Top Process ---
sketchybar --add item cpu.top right \
           --set cpu.top label.font="VictorMono Nerd Font Mono:Regular:10.0" \
                         label.y_offset=6 \
                         width=0 \
                         icon.drawing=off \
                         click_script="open -a 'Activity Monitor'" \
           --add item cpu.percent right \
           --set cpu.percent label.font="VictorMono Nerd Font Mono:Bold:16.0" \
                             label.y_offset=-4 \
                             label.color=$YELLOW \
                             icon.drawing=off \
                             update_freq=2 \
                             script="$PLUGIN_DIR/cpu.sh" \
                             click_script="open -a 'Activity Monitor'" \
           --add graph cpu.graph right 75 \
           --set cpu.graph graph.color=$GREEN \
                           graph.fill_color=0x80ebcb8b \
                           graph.line_width=1.5 \
                           icon.drawing=off \
                           click_script="open -a 'Activity Monitor'"

# --- Left: Spotify / Music (conditional) ---
if [ "$SHOW_MUSIC" = "true" ]; then
    sketchybar --add item music left \
               --set music update_freq=2 \
                           icon="󰓇" \
                           icon.font="VictorMono Nerd Font Mono:Regular:22.0" \
                           icon.color=$MAGENTA \
                           icon.padding_left=10 \
                           icon.padding_right=4 \
                           script="$PLUGIN_DIR/music.sh"
fi

sketchybar --update
