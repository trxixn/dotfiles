# ================================================================
# APP LAUNCHERS & SYSTEM
# ================================================================

# Screnshot area
alt - s : screencapture -i -c

# Screenshot whole screen
alt + shift - s : screencapture -c

# Open terminal
alt - return : open -a Kitty

# Open browser
alt - b : MOZ_DISABLE_SAFE_MODE_KEY=1 open -a "Zen"

# Close the current window only
alt - w : yabai -m window --close

# Fully quit/terminate the entire application
alt - q : skhd -k "cmd - q"

# Reload yabai and skhd configurations instantly
alt + shift - r : yabai --restart-service; skhd --restart-service

# ================================================================
# WINDOW FOCUS & MOVEMENT (i3 VIM KEYS)
# ================================================================
# Focus window
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Swap managed window (keeps window in the same general split)
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# ================================================================
# SPACES (WORKSPACES) 
# ================================================================
# Fast focus desktop 1-5
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5

# Send window to desktop (does NOT follow focus - standard i3 behavior)
alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5

# Send window to desktop and follow focus (Alternative)
# alt + shift - 1 : yabai -m window --space 1; yabai -m space --focus 1

# ================================================================
# MULTI-MONITOR (DISPLAYS)
# ================================================================
# Focus next/previous monitor
alt - tab : yabai -m display --focus next
alt + shift - tab : yabai -m display --focus prev

# Send window to next monitor and follow focus
alt + shift - m : yabai -m window --display next; yabai -m display --focus next

# ================================================================
# LAYOUT TOGGLES & RESIZING
# ================================================================

alt - f : yabai -m window --toggle native-fullscreen

# Float / unfloat window and center on screen
alt - space : yabai -m window --toggle float --grid 4:4:1:1:2:2


# Balance size of all windows
# alt - = : yabai -m space --balance

# Increase/Decrease window size (using ctrl + alt + vim keys)
ctrl + alt - h : yabai -m window --resize left:-20:0 || yabai -m window --resize right:-20:0
ctrl + alt - j : yabai -m window --resize bottom:0:20 || yabai -m window --resize top:0:20
ctrl + alt - k : yabai -m window --resize bottom:0:-20 || yabai -m window --resize top:0:-20
ctrl + alt - l : yabai -m window --resize left:20:0 || yabai -m window --resize right:20:0




